# Pokemon Card Arbitrage - Environment Variables
# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir:
# cp .env.example .env

# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# PokéWallet API (https://pokewallet.io - ücretsiz: 100 req/saat)
POKEWALLET_API_KEY=your_pokewallet_api_key_here

# Döviz Kuru ve Kâr Eşikleri
GBP_TO_EUR=1.17
MIN_PROFIT_EUR=2.0
MIN_PROFIT_PERCENT=15.0

# Otomatik Tarama Ayarları
AUTO_SCAN_INTERVAL_HOURS=6
AUTO_SCAN_SET_COUNT=3

# İzlenecek setler (virgülle ayır, boş bırakırsan son setleri tarar)
# Örnek: WATCHLIST_SETS=sv6,sv5,sv4
WATCHLIST_SETS=
